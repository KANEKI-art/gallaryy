.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px}
.status-dot.green{background:#4caf50}
.status-dot.red{background:#f44336}
.status-dot.yellow{background:#ff9800}
.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0}
.action-btn{background:#1a1a2e;border:1px solid #333;border-radius:12px;padding:20px 16px;text-align:center;cursor:pointer;transition:all .3s;color:#fff}
.action-btn:active{transform:scale(0.95)}
.action-btn .icon{font-size:32px;margin-bottom:8px;display:block}
.action-btn .label{font-size:13px;font-weight:500}
.action-btn .sub-label{font-size:11px;color:#888;margin-top:4px}
.account-list{display:flex;flex-direction:column;gap:12px}
.account-btn{display:flex;align-items:center;gap:16px;background:#1a1a1a;border:1px solid #333;border-radius:12px;padding:16px;cursor:pointer;color:#fff}
.account-btn .logo{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:28px}
.account-btn .logo.ig{background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)}
.account-btn .logo.fb{background:#1877f2}
.account-btn .logo.gl{background:#fff;color:#4285f4}
