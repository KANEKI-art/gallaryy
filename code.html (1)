.video-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.video-card{cursor:pointer;border-radius:12px;overflow:hidden;background:#1a1a1a}
.video-thumb{width:100%;aspect-ratio:16/9;background:#333;display:flex;align-items:center;justify-content:center;font-size:40px;color:#555}
.video-info{padding:8px}
.video-title{font-size:13px;font-weight:500;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.video-meta{font-size:11px;color:#888}
.perm-banner{background:linear-gradient(135deg,#1a1a2e,#16213e);border:1px solid #0f3460;border-radius:12px;padding:16px;margin-bottom:16px;display:none}
